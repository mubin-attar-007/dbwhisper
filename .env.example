# ─────────────────────────────────────────────────────────────────────────────
# DBWhisper — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM PROVIDERS ───────────────────────────────────────────────────────────
# At least one is required. The agent tries providers in priority order
# (see PROVIDER_PRIORITY in app/agent/chain.py) and falls back on rate limits.
# Google Gemini (free tier) powers BOTH chat and the default embedding provider.
# GEMINI_API_KEY is automatically aliased to GOOGLE_API_KEY at startup.
GEMINI_API_KEY=
# Groq (free, fast):
GROQ_API_KEY=
# Optional additional providers:
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# ─── PROJECT DATABASE (Postgres + pgvector) ──────────────────────────────────
# Stores conversation memory and schema embeddings. Requires the `vector` extension.
#   Local:  postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
#   Neon:   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
POSTGRES_CONNECTION_STRING=

# ─── EMBEDDINGS ──────────────────────────────────────────────────────────────
# Set via EMBEDDING_PROFILE above. The default (auto) runs BAAI/bge-small-en-v1.5 locally on the
# CPU through fastembed/ONNX - no API key, ~50 MB, downloaded once on first use.
# Override the local model if you want a different one:
# EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
#
# Vectors are model-specific and are stamped with an embedding version. Changing the model creates
# a NEW version rather than corrupting the old index; run the re-embed job to migrate.
#
# DEPRECATED: EMBEDDING_PROVIDER (google|huggingface) is still read and mapped onto
# EMBEDDING_PROFILE, with a warning. Prefer EMBEDDING_PROFILE.
# EMBEDDING_PROVIDER=

# ─── APPLICATION MODE (v2) ───────────────────────────────────────────────────
# demo | self_hosted | production  — one typed policy object (app/platform/modes.py) decides
# auth, connection, network, secret and egress behaviour. Defaults to self_hosted; a legacy
# APP_ENV=production without APP_MODE is treated as production (with a warning).
APP_MODE=self_hosted

# ─── SECRETS AT REST ─────────────────────────────────────────────────────────
# Comma-separated Fernet keys used to encrypt stored connection strings. The FIRST key encrypts,
# all keys decrypt (rotation: prepend a new key, re-encrypt, drop the old one).
# Generate one with:  uv run python -m app.platform.secrets generate-key
DBW_SECRET_KEYS=

# ─── LOCAL-FIRST AI ──────────────────────────────────────────────────────────
# Ollama (or any OpenAI-compatible local server). No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# auto | fake | local-small | local-balanced | local-quality | <remote profile name>
MODEL_PROFILE=auto
# auto | fake | local-bge-small | google
EMBEDDING_PROFILE=auto
# Overrides the mode default: LOCAL_ONLY | SCHEMA_ONLY_REMOTE | MASKED_METADATA_REMOTE |
# AGGREGATES_REMOTE | REMOTE_ALLOWED
EGRESS_POLICY=

# ─── NETWORK POLICY (target connections) ─────────────────────────────────────
# Hosts / CIDRs that may be connected to in production (strict) mode, comma-separated.
NETWORK_ALLOWLIST=
# Only honour X-Forwarded-For / X-Real-IP when the API sits behind a proxy you control.
TRUST_PROXY_HEADERS=false

# ─── OPENTELEMETRY / METRICS ─────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dbwhisper-api
METRICS_ENABLED=true

# ─── SERVER ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# development | production  (production logs a warning if CORS is left wide-open)
APP_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" is fine for local dev; in production set this
# to your exact frontend origin(s), e.g. https://dbwhisper.vercel.app
CORS_ALLOW_ORIGINS=*

# ─── AUTH (API-key gate for the powerful /schemas/* endpoints) ────────────────
# Comma-separated tokens. Presence enables auth; REQUIRED in production.
API_AUTH_TOKENS=
AUTH_REQUIRED=false
# Also require an API key on /query (keep false to leave the public demo reachable).
GATE_QUERY_ENDPOINT=false

# ─── RATE LIMITING (per-IP token bucket) ──────────────────────────────────────
# Held in this process's memory: a real limit for one instance, NOT a limit across replicas
# (two instances each admit the full burst). Put a shared limiter in front if you run more
# than one. TRUST_PROXY_HEADERS below decides whether X-Forwarded-For is believed.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST=30
RATE_LIMIT_PER_SEC=0.5
QUERY_RATE_LIMIT_BURST=8
QUERY_RATE_LIMIT_PER_SEC=0.1

# ─── LOGGING / OBSERVABILITY ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# LOG_JSON= (blank → JSON in production, human-readable in dev)
LOG_JSON=
# Sentry error tracking (optional; no-op when unset)
SENTRY_DSN=

# ─── USER AUTH & SESSIONS ────────────────────────────────────────────────────
# Gate /query and /schemas/* behind a login and scope databases to their owner.
USER_AUTH_ENABLED=false
# Session lifetime in seconds (default 14 days).
SESSION_TTL_SECONDS=1209600
# Blank => Secure cookies in production/demo, plain in self-hosted. Override only for local HTTPS.
SESSION_COOKIE_SECURE=
# CSRF defence for cookie sessions: Origin/Referer check plus a double-submit token. Blank => on in
# production, off in self-hosted (a single-user local box usually runs CORS_ALLOW_ORIGINS=*, where an
# origin allowlist means nothing), not applicable in demo (no login, so no ambient authority to
# abuse). API-key and other cookie-less callers are never affected. Set true to enforce anyway.
CSRF_ENFORCED=

# ─── APPLICATION DATABASE (alternatives) ─────────────────────────────────────
# Takes precedence over POSTGRES_CONNECTION_STRING when set. Useful when the app database and the
# pgvector store are deliberately different instances.
PROJECT_DB_CONNECTION_STRING=
# Used only by the Alembic CLI when you want to migrate a database other than the configured one.
DBW_ALEMBIC_URL=

# ─── BACKGROUND WORKER ───────────────────────────────────────────────────────
# Seconds the worker sleeps when the queue is empty. Run it with: python -m app.jobs.worker
WORKER_POLL_INTERVAL_SECONDS=2.0

# ─── TOOL CACHE & INTERNAL RATE LIMITS ───────────────────────────────────────
# Per-run caching of retrieval calls, and a guard against an agent looping on the same tool.
TOOL_CACHE_TTL_SECONDS=60
TOOL_CACHE_MAX_ITEMS=1024
TOOL_RATE_LIMIT_BURST=16
TOOL_RATE_LIMIT_PER_SEC=8

# ─── LOGGING (additional) ────────────────────────────────────────────────────
# Redaction of secrets and SQL literals before anything is written. Leave enabled.
LOG_SANITIZE=1

# ─── QUERY-RESULT CACHE ───────────────────────────────────────────────────────
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

